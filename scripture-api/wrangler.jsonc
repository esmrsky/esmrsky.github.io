{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "esmrsky-scripture-api",
  "main": "src/index.js",
  "compatibility_date": "2026-07-17",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ALLOWED_ORIGINS": "https://esmrsky.github.io,http://localhost:8000,http://127.0.0.1:8000"
  },
  "observability": {
    "enabled": true
  }
}
